# Copy to .env and fill in. All values also map to config.yaml keys.
# LLM (any OpenAI-compatible API: OpenAI, Ollama, vLLM, LM Studio)
LENDING_LLM_BASE_URL=http://localhost:11434/v1
LENDING_LLM_API_KEY=
LENDING_LLM_MODEL=llama3.1

# Retrieval overrides (optional)
# LENDING_RETRIEVAL_EMBED_BACKEND=sentence_transformers
# LENDING_RETRIEVAL_TOP_K=5
# LENDING_RETRIEVAL_RERANK=true

# Server
# LENDING_APP_HOST=0.0.0.0
# LENDING_APP_PORT=8000
